# Postgres connection string
# Local example: postgresql://postgres:password@localhost:5432/govtrack
# Neon/Supabase: use the connection string they give you (include ?sslmode=require)
DATABASE_URL="postgresql://postgres:password@localhost:5432/govtrack"

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET="replace_this_with_a_long_random_string"

# Server port
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL="http://localhost:5173"