generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- USERS ----------
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())

  registeredProjects Project[]        @relation("RegisteredBy")
  contractedProjects Project[]        @relation("ContractedTo")
  progressUpdates    ProgressUpdate[] @relation("SubmittedBy")
  reviewedUpdates    ProgressUpdate[] @relation("ReviewedBy")
  editLogs           EditLog[]
}

enum Role {
  ADMIN
  GOVT_EMPLOYEE
  CONTRACTOR
  VIEWER
}

// ---------- PROJECTS ----------
model Project {
  id              String        @id @default(uuid())
  name            String
  description     String?
  category        Category
  state           String
  district        String?
  agency          String
  status          ProjectStatus @default(PLANNED)
  percentComplete Int           @default(0)

  startDate       DateTime?
  plannedDeadline DateTime?
  revisedDeadline DateTime?
  completedDate   DateTime?

  latitude  Float?
  longitude Float?

  registeredById String
  registeredBy   User    @relation("RegisteredBy", fields: [registeredById], references: [id])

  contractorId String?
  contractor   User?   @relation("ContractedTo", fields: [contractorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budget          Budget?
  milestones      Milestone[]
  sources         Source[]
  editLogs        EditLog[]
  progressUpdates ProgressUpdate[]
}

enum Category {
  RAIL
  METRO
  ROAD
  BRIDGE
  BUILDING
  IRRIGATION
  POWER
  OTHER
}

enum ProjectStatus {
  PLANNED
  ONGOING
  DELAYED
  COMPLETED
}

// ---------- BUDGET ----------
model Budget {
  id               String   @id @default(uuid())
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sanctionedAmount Float
  releasedAmount   Float    @default(0)
  utilizedAmount   Float    @default(0)
  fundingSource    String
  currency         String   @default("INR")
  lastUpdated      DateTime @updatedAt
}

// ---------- MILESTONES ----------
model Milestone {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
}

// ---------- SOURCES ----------
model Source {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  url       String
  type      String
  createdAt DateTime @default(now())
}

// ---------- PROGRESS UPDATES ----------
model ProgressUpdate {
  id              String       @id @default(uuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractorId    String
  contractor      User         @relation("SubmittedBy", fields: [contractorId], references: [id])
  percentComplete Int
  amountUtilized  Float
  notes           String?
  proofUrl        String?
  status          UpdateStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?        @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewNotes     String?
  createdAt       DateTime     @default(now())
  reviewedAt      DateTime?
}

enum UpdateStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------- EDIT LOG ----------
model EditLog {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  diff      Json?
  createdAt DateTime @default(now())
}